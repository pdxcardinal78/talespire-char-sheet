{
  "manifest_version": 3,
  "name": "Spirekeeper Importer",
  "version": "0.1.0",
  "description": "Copy a D&D Beyond character straight into Spirekeeper, including private ones.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://*.dndbeyond.com/*"
  ],
  "action": {
    "default_title": "Copy this character for Spirekeeper",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.dndbeyond.com/characters/*"
      ],
      "js": [
        "rolls.js",
        "link.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
