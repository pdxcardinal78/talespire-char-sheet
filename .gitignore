# TaleSpire writes Symbiote debug logs into the Symbiote folder itself
symbiote/.debug/

# ...and the Symbiote's stored data, which is the player's characters and
# encounters. It must never be committed or shipped with the mod. Each installed
# build keeps its own, so every build needs its own line here.
symbiote/.localStorage/

# Scratch copies used when driving the extension popup in a browser
extension/_fixture.json
extension/_uitest.html

# Scratch copies used when driving the panel in a browser
symbiote/_devsample.json

.DS_Store
node_modules/

# TaleSpire's own assemblies, copied locally to compile the plugin against.
# They are Bouncyrock's files and must never be committed.
plugin/refs/
# Downloaded build tools and plugin build output
plugin/.tools/
plugin/bin/
plugin/obj/
plugin/dist/
plugin/tools/*/bin/
plugin/tools/*/obj/
